# NTP
ntp:
  enabled: true
  ntp_client: chrony
  pools:
    - tko-ott2.time.private-prive.cloud-nuage.canada.ca
    - tko-ott2.time.private-prive.cloud-nuage.gc.ca

# Packages
packages:
  # Core system packages
  - qemu-guest-agent
  - gnupg2

  # headers (needed for dkms with nvidia-kernel-open-dkms)
  - linux-headers-cloud-amd64

  # nvidia: headless compute driver. nvidia-driver-cuda provides nvidia-smi and libcuda,
  # which the GPU Operator validator requires. The nvidia-driver package is the desktop
  # driver and pulls in X.org without either of them.
  - nvidia-driver-cuda
  - nvidia-kernel-open-dkms

package_update: true
package_upgrade: true

# Keep the driver initialised between jobs (NVIDIA's recommendation for compute nodes).
# The Debian package installs nvidia-persistenced disabled. runcmd runs after the
# post-install reboot, once the NVIDIA module is loaded. Rancher appends its own
# install command to this list.
runcmd:
  - sysctl --system
  - systemctl enable --now nvidia-persistenced

# Required: the upgrade installs a newer kernel and DKMS builds the NVIDIA module for it,
# so the node must boot that kernel before the driver loads. The reboot happens before
# Rancher installs RKE2. Expected side effect: the first boot's
# /var/log/cloud-init-output.log ends with a "_fire_reboot" traceback, because systemd
# stops cloud-init while it waits for the reboot. It is not a failure; after the reboot
# `cloud-init status --long` reports done with no errors.
package_reboot_if_required: true
