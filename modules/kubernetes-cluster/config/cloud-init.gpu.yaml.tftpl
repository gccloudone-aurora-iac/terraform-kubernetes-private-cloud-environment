#cloud-config

# Configure apt repository to point to our internal version
apt:
  generate_mirrorlists: false
  preserve_sources_list: false
  disable_suites:
    - updates
    - backports

  primary:
    - arches:
      - amd64
      uri: https://artifacts-artefacts.devops.cloud-nuage.canada.ca/artifactory/debian-remote

  security:
    - arches:
      - amd64
      uri: https://artifacts-artefacts.devops.cloud-nuage.canada.ca/artifactory/debian-security-remote

  sources:
    nvidia:
      source: 'deb [signed-by=/etc/apt/keyrings/nvidia.gpg] https://artifacts-artefacts.devops.cloud-nuage.canada.ca/artifactory/ssc-pcc-debian-nvidia-remote/libnvidia-container/stable/deb/$(ARCH) /'

    cuda:
      source: 'deb [signed-by=/etc/apt/keyrings/cuda.gpg] https://artifacts-artefacts.devops.cloud-nuage.canada.ca/artifactory/ssc-pcc-debian-cuda-remote/compute/cuda/repos/debian13/x86_64/ /'

# Add credentials for artifactory
write_files:
  - path: /etc/apt/auth.conf.d/gcsa.conf
    owner: 'root:root'
    permissions: '0600'
    content: |
      machine artifacts-artefacts.devops.cloud-nuage.canada.ca login ${gcsa_username} password ${gcsa_password}

  # Kubernetes nodes run many inotify users (kubelet, containerd, log collectors, apps);
  # the kernel default of 128 instances per user causes "too many open files". The watch
  # limit is left to the kernel, which already scales it with memory.
  - path: /etc/sysctl.d/90-kubernetes-inotify.conf
    owner: 'root:root'
    permissions: '0644'
    content: |
      fs.inotify.max_user_instances = 8192

  # Graceful node shutdown: when OpenStack stops or reboots the VM, the kubelet gets 60 s
  # to stop pods (the last 20 s for critical pods). These are KubeletConfiguration fields,
  # not kubelet flags; RKE2 reads drop-ins from this directory.
  - path: /var/lib/rancher/rke2/agent/etc/kubelet.conf.d/90-graceful-shutdown.conf
    owner: 'root:root'
    permissions: '0600'
    content: |
      apiVersion: kubelet.config.k8s.io/v1beta1
      kind: KubeletConfiguration
      shutdownGracePeriod: 60s
      shutdownGracePeriodCriticalPods: 20s

  # unattended-upgrades ships a logind drop-in limiting shutdown delays to 30 s. It sorts
  # after the kubelet's own 60 s override and wins, so the kubelet's shutdown manager
  # never starts. A file with the same name in /etc replaces the packaged one.
  - path: /etc/systemd/logind.conf.d/unattended-upgrades-logind-maxdelay.conf
    owner: 'root:root'
    permissions: '0644'
    content: |
      [Login]
      InhibitDelayMaxSec=60

  # Pin every NVIDIA driver package to one version (var.nvidia_driver_version), so all
  # GPU nodes get the same driver and apt never upgrades it. The kernel module and the
  # user-space libraries must match, or nvidia-smi fails. Packages without this version
  # (e.g. libnvidia-egl-*) are unaffected.
  - path: /etc/apt/preferences.d/nvidia-driver
    owner: 'root:root'
    permissions: '0644'
    content: |
      Package: nvidia-* libnvidia-* libcuda* libnv* firmware-nvidia-* xserver-xorg-video-nvidia
      Pin: version ${nvidia_driver_version}
      Pin-Priority: 1001

  - path: /etc/apt/keyrings/nvidia.gpg
    owner: 'root:root'
    permissions: '0644'
