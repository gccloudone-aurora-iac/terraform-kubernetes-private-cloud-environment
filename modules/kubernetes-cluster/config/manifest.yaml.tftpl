apiVersion: v1
kind: Secret
metadata:
  name: gcsa-helm
  namespace: kube-system
type: kubernetes.io/basic-auth
stringData:
  username: ${jsonencode(gcsa_username)}
  password: ${jsonencode(gcsa_password)}
---
apiVersion: helm.cattle.io/v1
kind: HelmChart
metadata:
  name: openstack-cloud-controller-manager
  namespace: kube-system
spec:
  bootstrap: true
  chart: openstack-cloud-controller-manager
  version: ${jsonencode(openstack_chart_versions.cloud_controller_manager)}
  repo: https://artifacts-artefacts.devops.cloud-nuage.canada.ca/artifactory/api/helm/ssc-pcc-helm
  authSecret:
    name: gcsa-helm
  targetNamespace: kube-system
  valuesContent: |-
    dnsPolicy: Default
    nodeSelector:
      node-role.kubernetes.io/control-plane: 'true'
    tolerations:
      - key: node.cloudprovider.kubernetes.io/uninitialized
        value: "true"
        effect: NoSchedule
      - key: node-role.kubernetes.io/control-plane
        effect: NoSchedule
      - key: node-role.kubernetes.io/etcd
        effect: NoExecute
    controllerExtraArgs: |-
      - --cluster-cidr=${join(",", cluster_cidr)}
    cloudConfig:
      global:
        auth-url: ${jsonencode(auth_url)}
        domain-id: ${jsonencode(domain_id)}
        tenant-id: ${jsonencode(project_id)}
        tenant-domain-id: ${jsonencode(domain_id)}
        application-credential-id: ${jsonencode(application_credential_id)}
        application-credential-secret: ${jsonencode(application_credential_secret)}
        user-domain-id: default
        region: ${jsonencode(region)}
      loadBalancer:
        enabled: true
        network-id: ${jsonencode(network_id)}
        create-monitor: true
        internal-lb: false
        lb-provider: amphorav2
      metadata:
        search-order: metadataService
---
apiVersion: helm.cattle.io/v1
kind: HelmChart
metadata:
  name: cinder-csi-plugin
  namespace: kube-system
spec:
  bootstrap: true
  chart: openstack-cinder-csi
  version: ${jsonencode(openstack_chart_versions.cinder_csi)}
  repo: https://artifacts-artefacts.devops.cloud-nuage.canada.ca/artifactory/api/helm/ssc-pcc-helm
  authSecret:
    name: gcsa-helm
  targetNamespace: kube-system
  valuesContent: |-
    secret:
      enabled: true
      hostMount: false
      create: false
      name: cloud-config
    storageClass:
      enabled: false
      custom: |-
        ---
        apiVersion: storage.k8s.io/v1
        kind: StorageClass
        metadata:
          name: capacity-retain
          annotations:
            storageclass.kubernetes.io/is-default-class: "false"
        parameters:
          type: capacity
        provisioner: cinder.csi.openstack.org
        volumeBindingMode: Immediate
        reclaimPolicy: Retain
        allowVolumeExpansion: true
        ---
        apiVersion: storage.k8s.io/v1
        kind: StorageClass
        metadata:
          name: capacity-delete
          annotations:
            storageclass.kubernetes.io/is-default-class: "false"
        parameters:
          type: capacity
        provisioner: cinder.csi.openstack.org
        volumeBindingMode: Immediate
        reclaimPolicy: Delete
        allowVolumeExpansion: true
        ---
        apiVersion: storage.k8s.io/v1
        kind: StorageClass
        metadata:
          name: performance-retain
          annotations:
            storageclass.kubernetes.io/is-default-class: "false"
        parameters:
          type: performance
        provisioner: cinder.csi.openstack.org
        volumeBindingMode: Immediate
        reclaimPolicy: Retain
        allowVolumeExpansion: true
        ---
        apiVersion: storage.k8s.io/v1
        kind: StorageClass
        metadata:
          name: performance-delete
          annotations:
            storageclass.kubernetes.io/is-default-class: "true"
        parameters:
          type: performance
        provisioner: cinder.csi.openstack.org
        volumeBindingMode: Immediate
        reclaimPolicy: Delete
        allowVolumeExpansion: true
